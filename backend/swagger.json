    "/candidaturaStatus/{id}": {
      "put": {
        "summary": "Atualizar status da candidatura",
        "tags": [
          "Candidaturas"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "Em análise",
                      "Entrevista marcada",
                      "Aprovado",
                      "Não selecionado"
                    ]
                  }
                }
              },
              "example": {
                "status": "Entrevista marcada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado"
          }
        }
      }
    },
