    "/perfil/{id}": {
      "get": {
        "summary": "Buscar perfil",
        "tags": [
          "Perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil encontrado"
          }
        }
      },
      "put": {
        "summary": "Editar perfil",
        "tags": [
          "Perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_completo": {
                    "type": "string"
                  },
                  "data_nasc": {
                    "type": "string"
                  },
                  "telefone": {
                    "type": "string"
                  },
                  "cidade": {
                    "type": "string"
                  },
                  "sobre_voce": {
                    "type": "string"
                  },
                  "escolaridade": {
                    "type": "string"
                  },
                  "instituicao": {
                    "type": "string"
                  },
                  "curso": {
                    "type": "string"
                  },
                  "habilidades": {
                    "type": "string"
                  },
                  "foto": {
                    "type": "string",
                    "format": "binary"
                  },
                  "curriculo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil atualizado"
          }
        }
      }
    },
    "/seguranca/{id}": {
      "put": {
        "summary": "Alterar email e senha",
