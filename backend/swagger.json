{
  "openapi": "3.0.0",
  "info": {
    "title": "SIEP API",
    "version": "1.0.0",
    "description": "Documentação completa da API SIEP"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/cadastroUsuario": {
      "post": {
        "summary": "Cadastro de usuário",
        "tags": [
          "Usuário"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_completo": {
                    "type": "string"
                  },
                  "data_nasc": {
                    "type": "string"
                  },
                  "cpf": {
                    "type": "string"
                  },
                  "rg": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "telefone": {
                    "type": "string"
                  },
                  "endereco": {
                    "type": "string"
                  },
                  "cidade": {
                    "type": "string"
                  },
                  "uf": {
                    "type": "string"
                  },
                  "senha": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "nome_completo": "João Silva",
                "data_nasc": "2005-05-10",
                "cpf": "12345678900",
                "rg": "1234567",
                "email": "joao@email.com",
                "telefone": "11999999999",
                "endereco": "Rua A",
                "cidade": "São Paulo",
                "uf": "SP",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário cadastrado"
          }
        }
      }
    },
    "/loginUsuario": {
      "post": {
        "summary": "Login de usuário",
        "tags": [
          "Usuário"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": {
                    "type": "string"
                  },
                  "senha": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "cpf": "12345678900",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado"
          }
        }
      }
    },
