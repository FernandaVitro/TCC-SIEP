{
  "openapi": "3.0.0",
  "info": {
    "title": "SIEP API",
    "version": "1.0.0",
    "description": "Documentação completa da API SIEP"
  },

  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },

  "paths": {

    "/cadastroUsuario": {
      "post": {
        "summary": "Cadastro de usuário",
        "tags": ["Usuário"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_completo": { "type": "string" },
                  "data_nasc": { "type": "string" },
                  "cpf": { "type": "string" },
                  "rg": { "type": "string" },
                  "email": { "type": "string" },
                  "telefone": { "type": "string" },
                  "endereco": { "type": "string" },
                  "cidade": { "type": "string" },
                  "uf": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário cadastrado"
          }
        }
      }
    },

    "/loginUsuario": {
      "post": {
        "summary": "Login de usuário",
        "tags": ["Usuário"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado"
          }
        }
      }
    },

    "/cadastroEmpresa": {
      "post": {
        "summary": "Cadastro de empresa",
        "tags": ["Empresa"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_empresa": { "type": "string" },
                  "cnpj": { "type": "string" },
                  "email": { "type": "string" },
                  "telefone": { "type": "string" },
                  "setor_atuacao": { "type": "string" },
                  "endereco": { "type": "string" },
                  "cidade": { "type": "string" },
                  "uf": { "type": "string" },
                  "descricao": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empresa cadastrada"
          }
        }
      }
    },

    "/loginEmpresa": {
      "post": {
        "summary": "Login empresa",
        "tags": ["Empresa"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado"
          }
        }
      }
    },

    "/recuperarSenha": {
      "put": {
        "summary": "Recuperar senha usuário",
        "tags": ["Usuário"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": { "type": "string" },
                  "resposta": { "type": "string" },
                  "campo": { "type": "string" },
                  "novaSenha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada"
          }
        }
      }
    },

    "/recuperarSenhaEmpresa": {
      "put": {
        "summary": "Recuperar senha empresa",
        "tags": ["Empresa"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cnpj": { "type": "string" },
                  "resposta": { "type": "string" },
                  "campo": { "type": "string" },
                  "novaSenha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada"
          }
        }
      }
    },

    "/perguntaSeguranca": {
      "post": {
        "summary": "Pergunta segurança usuário",
        "tags": ["Usuário"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pergunta retornada"
          }
        }
      }
    },

    "/perguntaSegurancaEmpresa": {
      "post": {
        "summary": "Pergunta segurança empresa",
        "tags": ["Empresa"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cnpj": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pergunta retornada"
          }
        }
      }
    },

    "/perfil/{id}": {

      "get": {
        "summary": "Buscar perfil",
        "tags": ["Perfil"],
        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Perfil encontrado"
          }
        }
      },

      "put": {
        "summary": "Editar perfil",
        "tags": ["Perfil"],
        "security": [
          {
            "bearerAuth": []
          }
        ],

        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome_completo": { "type": "string" },
                  "data_nasc": { "type": "string" },
                  "telefone": { "type": "string" },
                  "cidade": { "type": "string" },
                  "sobre_voce": { "type": "string" },
                  "escolaridade": { "type": "string" },
                  "instituicao": { "type": "string" },
                  "curso": { "type": "string" },
                  "habilidades": { "type": "string" },

                  "foto": {
                    "type": "string",
                    "format": "binary"
                  },

                  "curriculo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Perfil atualizado"
          }
        }
      }
    },

    "/seguranca/{id}": {
      "put": {
        "summary": "Alterar email e senha",
        "tags": ["Perfil"],
        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "senhaAtual": { "type": "string" },
                  "novaSenha": { "type": "string" }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Dados atualizados"
          }
        }
      }
    },

    "/vagasCriar": {
      "post": {
        "summary": "Criar vaga",
        "tags": ["Vagas"],
        "security": [
          {
            "bearerAuth": []
          }
        ],

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",

                "properties": {
                  "titulo_vaga": { "type": "string" },
                  "tipo": { "type": "string" },
                  "modalidade": { "type": "string" },
                  "area": { "type": "string" },
                  "descricao": { "type": "string" },
                  "cidade": { "type": "string" },
                  "uf": { "type": "string" },
                  "salario": { "type": "string" },
                  "idade_minima": { "type": "integer" },
                  "idade_maxima": { "type": "integer" },

                  "requisitos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Vaga criada"
          }
        }
      }
    },

    "/deletarVaga/{id_vaga}": {
      "delete": {
        "summary": "Deletar vaga",
        "tags": ["Vagas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id_vaga",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Vaga deletada"
          }
        }
      }
    },

    "/editarVaga/{id_vaga}": {
      "put": {
        "summary": "Editar vaga",
        "tags": ["Vagas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id_vaga",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Vaga editada"
          }
        }
      }
    },

    "/vagasEmpresa/{id_empresa}": {
      "get": {
        "summary": "Listar vagas empresa",
        "tags": ["Vagas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id_empresa",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Lista de vagas"
          }
        }
      }
    },

    "/vagas": {
      "get": {
        "summary": "Listar vagas",
        "tags": ["Vagas"],

        "responses": {
          "200": {
            "description": "Lista de vagas"
          }
        }
      }
    },

    "/candidatar": {
      "post": {
        "summary": "Candidatar em vaga",
        "tags": ["Candidaturas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",

                "properties": {
                  "id_vaga": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Candidatura enviada"
          }
        }
      }
    },

    "/candidaturasEmpresa/{idEmpresa}": {
      "get": {
        "summary": "Listar candidaturas",
        "tags": ["Candidaturas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "idEmpresa",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Lista de candidaturas"
          }
        }
      }
    },

    "/candidatosEmpresa/{id_empresa}": {
      "get": {
        "summary": "Listar candidatos",
        "tags": ["Candidaturas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id_empresa",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Lista de candidatos"
          }
        }
      }
    },

    "/candidaturaStatus/{id}": {
      "put": {
        "summary": "Atualizar status candidatura",
        "tags": ["Candidaturas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Status atualizado"
          }
        }
      }
    },

    "/perfilCandidato/{id}": {
      "get": {
        "summary": "Perfil candidato",
        "tags": ["Perfil"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Perfil candidato"
          }
        }
      }
    },

    "/entrevistas": {
      "post": {
        "summary": "Criar entrevista",
        "tags": ["Entrevistas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "requestBody": {
          "required": true,

          "content": {
            "application/json": {
              "schema": {
                "type": "object",

                "properties": {
                  "id_candidatura": {
                    "type": "integer"
                  },

                  "data": {
                    "type": "string"
                  },

                  "horario": {
                    "type": "string"
                  },

                  "tipo": {
                    "type": "string"
                  },

                  "local_link": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Entrevista criada"
          }
        }
      }
    },

    "/totalEntrevistas/{id_empresa}": {
      "get": {
        "summary": "Total entrevistas empresa",
        "tags": ["Entrevistas"],

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id_empresa",
            "in": "path",
            "required": true,

            "schema": {
              "type": "integer"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Total de entrevistas"
          }
        }
      }
    }

  }
}