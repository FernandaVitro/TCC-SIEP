                  },
                  "salario": {
                    "type": "string"
                  },
                  "idade_minima": {
                    "type": "integer"
                  },
                  "idade_maxima": {
                    "type": "integer"
                  },
                  "requisitos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vaga criada"
          }
        }
      }
    },
